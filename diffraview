#!/bin/bash

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SOURCE" ]; do
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"

SERVER_ADDR=127.0.0.1
# Override with e.g. DIFFRAVIEW_SERVER_PORT=50020 ./diffraview
SERVER_PORT="${DIFFRAVIEW_SERVER_PORT:-50010}"
CLIENT_PORT="${DIFFRAVIEW_CLIENT_PORT:-50011}"
# Tells Electron which ports to use (see client/electron.cjs).
export DIFFRAVIEW_SERVER_PORT="$SERVER_PORT" DIFFRAVIEW_CLIENT_PORT="$CLIENT_PORT"

# Resolve conda path: env var > config file > error
if [ -n "$DIFFRAVIEW_CONDA" ]; then
  CONDA_BASE="$DIFFRAVIEW_CONDA"
elif [ -f "$HOME/.config/diffraview/config" ]; then
  CONDA_BASE="$(grep '^CONDA_BASE=' "$HOME/.config/diffraview/config" | cut -d= -f2-)"
else
  echo "Error: DIALS conda path not configured. Run install.sh first or set DIFFRAVIEW_CONDA." >&2
  exit 1
fi

if [ ! -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
  echo "Error: conda not found at $CONDA_BASE" >&2
  exit 1
fi

# Arguments: [--browser] [processing_dir]
BROWSER_MODE=""
PROCESSING_DIR=""
for arg in "$@"; do
  case "$arg" in
    --browser) BROWSER_MODE=1 ;;
    *) PROCESSING_DIR="$arg" ;;
  esac
done
if [ -n "$PROCESSING_DIR" ]; then
  PROCESSING_DIR="$(realpath "$PROCESSING_DIR")"
  if [ ! -d "$PROCESSING_DIR" ]; then
    echo "Error: directory not found: $PROCESSING_DIR" >&2
    exit 1
  fi
fi

kill_process_on_port() {
  PORT=$1
  PID=$(lsof -ti tcp:$PORT 2>/dev/null)
  if [ -n "$PID" ]; then
    echo "Killing existing process on port $PORT (PID $PID)..."
    kill -9 $PID 2>/dev/null || true
  fi
}

kill_process_on_port $SERVER_PORT
kill_process_on_port $CLIENT_PORT

echo "Activating DIALS environment..."
source "$CONDA_BASE/etc/profile.d/conda.sh"
conda activate "$CONDA_BASE"

if ! command -v diffraview-server &>/dev/null; then
  echo "Error: diffraview-server not found in $CONDA_BASE." >&2
  echo "The diffraview package is not installed in the DIALS environment. Install it with:" >&2
  echo "  $CONDA_BASE/bin/python -m pip install \"$SCRIPT_DIR\"" >&2
  echo "(or re-run install.sh)" >&2
  exit 1
fi

# The client (Vite) needs a recent Node.js; check before starting anything
if ! command -v node &>/dev/null; then
  echo "Error: Node.js not found; the client needs it (see README.md)." >&2
  exit 1
fi
NODE_REQUIRED="$(cd "$SCRIPT_DIR/client" && node -p "require('./node_modules/vite/package.json').engines.node" 2>/dev/null)"
if [ -n "$NODE_REQUIRED" ] && ! (cd "$SCRIPT_DIR/client" && node -e "
  let semver;
  try { semver = require('semver'); } catch { process.exit(0); }
  process.exit(semver.satisfies(process.version, process.argv[1]) ? 0 : 1);
" "$NODE_REQUIRED"); then
  echo "Error: Node.js $(node --version) ($(command -v node)) is too old; the client needs $NODE_REQUIRED." >&2
  echo "Install a newer Node.js, or put one first on PATH." >&2
  exit 1
fi

PYTHON_ARGS=("$SERVER_ADDR" "$SERVER_PORT")
[ -n "$PROCESSING_DIR" ] && PYTHON_ARGS+=(--processing-dir "$PROCESSING_DIR")

echo "Starting server..."
diffraview-server "${PYTHON_ARGS[@]}" &
SERVER_PID=$!

echo "Starting client..."
cd "$SCRIPT_DIR/client" || {
  echo "Error: client directory not found at $SCRIPT_DIR/client" >&2
  exit 1
}
npx vite --host localhost --port "$CLIENT_PORT" --strictPort &
CLIENT_PID=$!

cleanup() {
  echo "Shutting down..."
  kill $CLIENT_PID 2>/dev/null || true
  kill $SERVER_PID 2>/dev/null || true
}
trap cleanup EXIT

# Don't launch Electron until the server is actually accepting connections,
# otherwise the client just hangs on the loading screen with ERR_CONNECTION_REFUSED.
echo "Waiting for server on $SERVER_ADDR:$SERVER_PORT..."
for _ in $(seq 1 40); do
  if ! kill -0 $SERVER_PID 2>/dev/null; then
    echo "Error: server exited during startup (see its output above)." >&2
    exit 1
  fi
  if (exec 3<>"/dev/tcp/$SERVER_ADDR/$SERVER_PORT") 2>/dev/null; then
    SERVER_READY=1
    break
  fi
  sleep 0.25
done

if [ -z "$SERVER_READY" ]; then
  echo "Error: server did not start listening on $SERVER_ADDR:$SERVER_PORT within 10s." >&2
  exit 1
fi

if [ -z "$BROWSER_MODE" ]; then
  echo "Launching Electron..."
  npx electron --no-sandbox .
  exit 0
fi

echo "Waiting for client on localhost:$CLIENT_PORT..."
for _ in $(seq 1 40); do
  if (exec 3<>"/dev/tcp/127.0.0.1/$CLIENT_PORT") 2>/dev/null; then
    CLIENT_READY=1
    break
  fi
  sleep 0.25
done

if [ -z "$CLIENT_READY" ]; then
  echo "Error: client did not start listening on port $CLIENT_PORT within 10s." >&2
  exit 1
fi

# The client reads the server's port from ?port= (see client/src/lib/server.ts).
CLIENT_URL="http://localhost:$CLIENT_PORT/?port=$SERVER_PORT"
echo "Opening $CLIENT_URL in browser..."
if command -v xdg-open &>/dev/null; then
  xdg-open "$CLIENT_URL" >/dev/null 2>&1 &
elif command -v open &>/dev/null; then
  open "$CLIENT_URL"
else
  echo "Could not detect a browser launcher; open $CLIENT_URL manually."
fi

echo "DiffraView is running at $CLIENT_URL. Press Ctrl+C to stop."
wait $SERVER_PID
